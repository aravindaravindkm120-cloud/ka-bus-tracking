# ============================================================
# KA Bus Tracking - Backend environment variables
# Copy to a real .env / your deployment environment.
# NEVER commit real secrets.
# ============================================================

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ka_bus_tracking
DB_USER=root
DB_PASSWORD=
DB_POOL_SIZE=10

# Security
# Generate with: openssl rand -base64 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_CHAR_BASE64_SECRET
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# Servers
SERVER_PORT=8080
API_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Rate limits (per-minute, per key)
RATE_LIMIT_LOGIN=5
RATE_LIMIT_GPS=120
RATE_LIMIT_PUBLIC=120

# GPS validation
GPS_MIN_INTERVAL_MS=3000
GPS_MAX_SKEW_MS=30000

# Live status thresholds (seconds)
LIVE_SECONDS=60
STALE_SECONDS=600

# Retention
LOCATION_HISTORY_RETENTION_DAYS=30

# Optional development users (~/.env / dev profile only, see DataInitializer docs)
SEED_DEMO_USERS=true

# Bootstrap Super Admin (SEED_ only used on first startup when no admin exists)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=Admin@123
SEED_ADMIN_EMAIL=admin@kabus.local
SEED_ADMIN_FULL_NAME=Super Administrator

# Logging
LOG_SQL=warn
# ============================================================
# KA Bus Tracking - Passenger Web production build config
# Loaded by `vite build` (mode=production) ONLY.
# Local development is unaffected: `npm run dev` uses the
# Vite proxy in vite.config.ts (target http://localhost:8080)
# and stays same-origin when these vars are absent.
# ============================================================
VITE_API_URL=https://ka-bus-tracking-production.up.railway.app
VITE_WS_URL=https://ka-bus-tracking-production.up.railway.app
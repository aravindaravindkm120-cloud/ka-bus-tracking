# Optional. Defaults: same-origin (empty) in production, http://localhost:8080 in dev.
# Set to the publicly reachable backend when the static site is hosted separately.
VITE_API_URL=
VITE_WS_URL=
# Production example (also copied to .env.production for `npm run build`):
#   VITE_API_URL=https://ka-bus-tracking-production.up.railway.app
#   VITE_WS_URL=https://ka-bus-tracking-production.up.railway.app
# Dev only: proxy target for /api and /ws (Vite dev server).
VITE_DEV_PROXY=http://localhost:8080